# Local isolated acceptance only. Never reuse these public test values outside S7.
APP_ENV=testing
MYSQL_USER=mtrip
MYSQL_PASSWORD=mtrip-s7-database-only
MYSQL_ROOT_PASSWORD=mtrip-s7-root-only
MTRIP_JWT_SECRET=mtrip-s7-local-jwt-not-production
MTRIP_AES_KEY=mtrip-s7-local-data-not-production
MTRIP_ADMIN_AES_KEY=0123456789abcdef0123456789abcdef
MTRIP_CLIENT_SIGN=true
MTRIP_PAYLOAD_ENCRYPT=true
MTRIP_SUBMIT_LOCK=true
MTRIP_REQUEST_LOG=false
SCAN_CACHEABLE=false
