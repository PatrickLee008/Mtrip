# ── Mtrip 本地开发统一配置(Windows 原生 / Swow)────────────────────────
# 用法:复制到项目【外】的固定位置(默认 %USERPROFILE%\.mtrip\mtrip.env),按你的机器改值。
#      这份文件由你自己维护;仓库不收录、Docker 也读不到,天然与生产隔离。
# 保存编码:ANSI 或 UTF-8(无 BOM)。值里不要有空格/引号。
# 注意:HTTP_PORT 不在这里配 —— 由 start-svc.bat 按服务传入(9501~9508)。

APP_ENV=dev
SCAN_CACHEABLE=false
WORKER_NUM=2
MAX_REQUEST=10000

# ── MySQL(A 方案:连本机原生 MySQL,mtrip 账号)──────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=mtrip
DB_PASSWORD=mtrip@2026
DB_SYSTEM_DATABASE=mtrip_system
DB_BUSINESS_DATABASE=mtrip_business
DB_MAX_CONNECTIONS=10

# ── Redis(本机原生,独立 1 号库,避免和其他项目撞 key)──────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_AUTH=
REDIS_DB=1

# ── 全平台统一密钥(本地随便填;生产密钥在 deploy/.env 另配强随机值)──
MTRIP_JWT_SECRET=mtrip-dev-jwt-secret-change-me
MTRIP_JWT_TTL=7200
MTRIP_APP_JWT_TTL=604800
MTRIP_AES_KEY=mtrip-dev-aes-key-change-me
MTRIP_ADMIN_AES_KEY=mtrip-dev-admin-login-key-change-me

# ── 接口安全 / 调试开关 ────────────────────────────────────────────
# 本地用 curl / Apifox 调 app 接口不方便做签名/加密时,把下面两个设 false 更省事
MTRIP_CLIENT_SIGN=true
MTRIP_SIGN_TTL=3600
MTRIP_PAYLOAD_ENCRYPT=true
# 全量请求日志(排查时 true,写 runtime 日志)
MTRIP_REQUEST_LOG=true

# ── 提交防重(Redis 并发锁 / X-Form-Id 幂等)──────────────────────
MTRIP_SUBMIT_LOCK=true
MTRIP_SUBMIT_LOCK_TTL=10
MTRIP_FORM_ID_TTL=300
