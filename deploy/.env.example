# Mtrip deploy 环境变量样例:复制为 .env 后按需修改
# Copy-Item .env.example .env

# ---------- 运行环境 ----------
APP_ENV=dev

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=root@2026
MYSQL_USER=mtrip
# 注意:database/init/00-create-databases.sql 中应用账号密码为 mtrip@2026,
# 修改此处需同步修改该脚本(或首次初始化后手动 ALTER USER)
MYSQL_PASSWORD=mtrip@2026
# 宿主机映射端口(本机 3306 已被占用时无需改动,默认 3307)
MYSQL_HOST_PORT=3307

# ---------- Redis ----------
REDIS_HOST_PORT=6380

# ---------- 网关 ----------
# 8080 常被本机其它开发服务(如 HBuilderX H5)占用,默认改用 8081
GATEWAY_HOST_PORT=8081

# ---------- 全平台统一密钥(生产环境必须更换为强随机值) ----------
MTRIP_JWT_SECRET=mtrip-dev-jwt-secret-change-me
MTRIP_AES_KEY=mtrip-dev-aes-key-change-me

# ---------- 排查模式 ----------
# true 时所有服务记录全量请求/响应/异常到 deploy/logs/<服务名>/request.log(生产保持 false)
MTRIP_REQUEST_LOG=true
