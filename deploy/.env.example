# Mtrip deploy 环境变量样例:复制为 .env 后按需修改
# Copy-Item .env.example .env

# ---------- 运行环境 ----------
APP_ENV=dev

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=root@2026
MYSQL_USER=mtrip
# 注意:database/init/00-create-databases.sql 中应用账号密码为 mtrip@2026,
# 修改此处需同步修改该脚本(或首次初始化后手动 ALTER USER)
MYSQL_PASSWORD=mtrip@2026
# 宿主机映射端口(本机 3306 已被占用时无需改动,默认 3307)
MYSQL_HOST_PORT=3307

# ---------- Redis ----------
REDIS_HOST_PORT=6380

# ---------- 网关 ----------
# 8080 常被本机其它开发服务(如 HBuilderX H5)占用,默认改用 8081
GATEWAY_HOST_PORT=8081

# ---------- 全平台统一密钥(生产环境必须更换为强随机值) ----------
MTRIP_JWT_SECRET=mtrip-dev-jwt-secret-change-me
MTRIP_AES_KEY=mtrip-dev-aes-key-change-me

# ---------- 排查模式 ----------
# true 时所有服务记录全量请求/响应/异常到 deploy/logs/<服务名>/request.log(生产保持 false)
MTRIP_REQUEST_LOG=true

# ---------- 接口安全(签名与传输加密) ----------
# app 接口客户端签名校验开关(生产必须 true;本地 curl 调试可临时 false)
MTRIP_CLIENT_SIGN=true
# 签名时间窗口(秒),超过视为请求无效,默认 1 小时
MTRIP_SIGN_TTL=3600
# 登录/注册等敏感接口强制 AES 加密传输开关(生产必须 true)
MTRIP_PAYLOAD_ENCRYPT=true
# 管理端登录传输加密密钥(与 admin-web .env 的 VITE_LOGIN_AES_KEY 同值,生产更换强随机值)
MTRIP_ADMIN_AES_KEY=mtrip-dev-admin-login-key-change-me

# ---------- 提交防重(Redis 并发锁/FormId 幂等) ----------
# 写操作(POST/PUT/PATCH/DELETE)提交防重开关:同一身份同一接口并发请求拒绝(42902)
MTRIP_SUBMIT_LOCK=true
# 并发锁兜底 TTL(秒),业务完成即释放,TTL 仅防进程异常死锁
MTRIP_SUBMIT_LOCK_TTL=10
# X-Form-Id 幂等窗口(秒):同一 FormId 成功提交后窗口内再提交直接拒绝
MTRIP_FORM_ID_TTL=300
