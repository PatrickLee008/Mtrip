# Mtrip 移动端环境变量模板(复制为 .env 使用,EXPO_PUBLIC_ 前缀才会注入客户端)
# 环境:development / staging / production
EXPO_PUBLIC_ENV=development
# 网关地址(开发直连本机网关/Nginx,各微服务经网关聚合)
EXPO_PUBLIC_API_BASE_URL=http://localhost:8081
# 默认站点ID(启动兜底,运行时可切换)
EXPO_PUBLIC_DEFAULT_SITE_ID=1
# 客户端密钥(管理后台「配置→客户端管理」创建后粘贴;用于 app 接口 HMAC 签名与登录/注册 AES 加密)
# 未配置时不附加签名/加密(需后端 MTRIP_CLIENT_SIGN=false 才能请求成功)
EXPO_PUBLIC_CLIENT_ID=
EXPO_PUBLIC_CLIENT_SECRET=
