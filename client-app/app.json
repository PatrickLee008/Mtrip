{
  "expo": {
    "name": "Mtrip",
    "slug": "mtrip-client-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "mtrip",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#4169ED"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mtrip.clientapp"
    },
    "android": {
      "package": "com.mtrip.clientapp"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow M-Trip to access your photos to upload your profile photo and ID documents.",
          "cameraPermission": "Allow M-Trip to use your camera to take your profile photo, ID document and selfie."
        }
      ]
    ]
  }
}
