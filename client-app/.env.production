# Mtrip 移动端生产环境变量(expo export -p web 时由 Expo 自动加载,NODE_ENV=production)
# 用途:H5 网页版,产物发布到 deploy/web/client/,由网关 8093 端口静态托管

# 环境:关掉 debug/info 日志(见 src/logs/logger.ts)
EXPO_PUBLIC_ENV=production

# 网关地址 —— 【必须是单个斜杠 "/" ,即同源相对路径】
# src/api/*.ts 里的 URL 本身就带全前缀(如 '/api/v1/app/goods/home'),
# 所以本变量语义是 **origin**(开发环境才填 http://localhost:8081),不是路径前缀。
#   填 '/api/v1' → 拼成 /api/v1/api/v1/app/... 直接 404(本文件之前就是这个错值);
#   【留空也不行】→ Expo 把空值的 .env 变量当作未定义丢弃,src/config/env.ts 的 `??`
#     会回落到 DEFAULT_BASE_URL.production = https://api.mtrip.com(实测编译产物确认);
#   填 '/' → axios 拼出 /api/v1/app/goods/home,resolveMediaUri 拼出 /uploads/x.png,均正确。
# 同源后由站点 nginx 把 /api/ 与 /uploads/ 反代到网关,与 admin/merchant/supplier 同一套模式
# (Docker 直连场景见 deploy/openresty/conf.d/mtrip.conf 的 8093 server 块;
#  宝塔建站场景需在站点配置里自行加这两条 proxy_pass,见 deploy/README.md)。
EXPO_PUBLIC_API_BASE_URL=/
# 默认站点ID(启动兜底,运行时可切换)
EXPO_PUBLIC_DEFAULT_SITE_ID=1
# 客户端密钥(管理后台「配置→客户端管理」创建后粘贴;用于 app 接口 HMAC 签名与登录/注册 AES 加密)
# 未配置时不附加签名/加密(需后端 MTRIP_CLIENT_SIGN=false 才能请求成功)
# 正式上线前必须在 admin-web「配置→客户端管理」建一个 app 客户端并把 Id/Secret 填进来,
# 否则 deploy/.env 的 MTRIP_CLIENT_SIGN=true 会让所有 /api/v1/app/* 请求被拒。
EXPO_PUBLIC_CLIENT_ID=
EXPO_PUBLIC_CLIENT_SECRET=
