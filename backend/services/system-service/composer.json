{
    "name": "mtrip/system-service",
    "description": "Mtrip 系统服务:登录JWT、管理员、角色RBAC、菜单树、操作日志、全局配置、多站点、存储/支付/短信/地图配置、客户端密钥/权限模板/接口日志",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "mtrip/shared": "*@dev",
        "hyperf/framework": "~3.1.0",
        "hyperf/di": "~3.1.0",
        "hyperf/http-server": "~3.1.0",
        "hyperf/database": "~3.1.0",
        "hyperf/db-connection": "~3.1.0",
        "hyperf/redis": "~3.1.0",
        "hyperf/config": "~3.1.0",
        "hyperf/context": "~3.1.0",
        "hyperf/validation": "~3.1.0",
        "hyperf/translation": "~3.1.0",
        "hyperf/exception-handler": "~3.1.0",
        "hyperf/logger": "~3.1.0",
        "hyperf/command": "~3.1.0",
        "hyperf/crontab": "~3.1.0",
        "hyperf/process": "~3.1.0",
        "hyperf/engine": "^2.10",
        "hyperf/support": "~3.1.0"
    },
    "require-dev": {
        "hyperf/devtool": "~3.1.0",
        "hyperf/testing": "~3.1.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../shared",
            "options": { "symlink": true }
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Test\\": "test/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "extra": [],
    "scripts": {
        "start": "php bin/hyperf.php start"
    }
}
