{
    "name": "mtrip/order-service",
    "description": "Mtrip 订单服务:C端下单/锁库存/支付/取消/退款申请/核销码(C端 /api/v1/app/order/* 与管理端 /api/v1/admin/order/* 公用服务)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "mtrip/shared": "*@dev",
        "hyperf/framework": "~3.1.0",
        "hyperf/di": "~3.1.0",
        "hyperf/http-server": "~3.1.0",
        "hyperf/database": "~3.1.0",
        "hyperf/db-connection": "~3.1.0",
        "hyperf/redis": "~3.1.0",
        "hyperf/config": "~3.1.0",
        "hyperf/context": "~3.1.0",
        "hyperf/validation": "~3.1.0",
        "hyperf/translation": "~3.1.0",
        "hyperf/exception-handler": "~3.1.0",
        "hyperf/logger": "~3.1.0",
        "hyperf/command": "~3.1.0",
        "hyperf/crontab": "~3.1.0",
        "hyperf/process": "~3.1.0",
        "hyperf/engine": "^2.10",
        "hyperf/support": "~3.1.0"
    },
    "require-dev": {
        "hyperf/devtool": "~3.1.0",
        "hyperf/testing": "~3.1.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../shared",
            "options": { "symlink": true }
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Test\\": "test/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "extra": [],
    "scripts": {
        "start": "php bin/hyperf.php start"
    }
}
