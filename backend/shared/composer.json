{
    "name": "mtrip/shared",
    "description": "Mtrip 平台微服务共享组件包:统一响应、错误码、JWT、RBAC、站点隔离、客户端签名、审计日志、加密脱敏",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "hyperf/framework": "~3.1.0",
        "hyperf/di": "~3.1.0",
        "hyperf/http-server": "~3.1.0",
        "hyperf/database": "~3.1.0",
        "hyperf/db-connection": "~3.1.0",
        "hyperf/redis": "~3.1.0",
        "hyperf/context": "~3.1.0",
        "hyperf/validation": "~3.1.0",
        "hyperf/exception-handler": "~3.1.0",
        "hyperf/support": "~3.1.0",
        "hyperf/snowflake": "~3.1.0"
    },
    "autoload": {
        "psr-4": {
            "Mtrip\\Shared\\": "src/"
        }
    },
    "extra": {
        "hyperf": {
            "config": "Mtrip\\Shared\\ConfigProvider"
        }
    }
}
