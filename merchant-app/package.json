{
  "name": "mtrip-merchant-app",
  "version": "1.0.0",
  "description": "Mtrip 商户移动端(Expo 51 + React Native + TypeScript,对齐 client-app 技术栈)",
  "main": "expo/AppEntry.js",
  "private": true,
  "scripts": {
    "start": "expo start --offline --port 8083",
    "android": "expo start --android --offline --port 8083",
    "ios": "expo start --ios --offline --port 8083",
    "web": "expo start --web --offline --port 8083",
    "build:web": "expo export -p web --clear",
    "typecheck": "tsc --noEmit",
    "dev": "expo start --web --offline --port 8083",
    "start:lan": "expo start --offline --port 8083",
    "web:lan": "expo start --web --offline --port 8083"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.2.3",
    "@expo-google-fonts/outfit": "^0.2.3",
    "@expo/metro-runtime": "~3.2.3",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.9.26",
    "axios": "^1.7.2",
    "crypto-js": "^4.2.0",
    "expo": "~51.0.28",
    "expo-font": "~12.0.9",
    "expo-localization": "~15.0.3",
    "expo-status-bar": "~1.12.1",
    "i18next": "^23.11.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-i18next": "^14.1.2",
    "react-native": "0.74.5",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-svg": "15.2.0",
    "react-native-web": "~0.19.10",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/crypto-js": "^4.2.2",
    "@types/react": "~18.2.79",
    "babel-plugin-module-resolver": "^5.0.2",
    "typescript": "~5.3.3"
  }
}
