# Mtrip 商户移动端生产环境变量(expo export -p web 时由 Expo 自动加载,NODE_ENV=production)
# 用途:H5 网页版,产物发布到 deploy/web/merchant-h5/,由网关 8094 端口静态托管

EXPO_PUBLIC_ENV=production

# 网关地址 —— 【必须是单个斜杠 "/" ,即同源相对路径】(原因同 client-app/.env.production)
# 本变量语义是 origin 不是路径前缀:src/api/*.ts 的 URL 自带 /api/v1/... 全前缀;
# 留空会被 Expo 当未定义丢弃,src/config/env.ts 回落到 https://api.mtrip.com。
EXPO_PUBLIC_API_BASE_URL=/
EXPO_PUBLIC_DEFAULT_SITE_ID=1

# 客户端密钥:入驻/KYC 走 /api/v1/app/merchant/*,deploy/.env 的 MTRIP_CLIENT_SIGN=true 时必须签名,
# 否则全部被拒。上线前在 admin-web「配置→客户端管理」建一个商户端 app 客户端,把 Id/Secret 填进来。
EXPO_PUBLIC_CLIENT_ID=
EXPO_PUBLIC_CLIENT_SECRET=

# 生产必须走真实后端,禁用静态原型模式
EXPO_PUBLIC_ONBOARDING_PROTOTYPE=false
